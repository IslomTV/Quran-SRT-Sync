1
00:00:00,000 --> 00:00:03,290
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا ﴿١﴾

2
00:00:03,290 --> 00:00:06,560
فَٱلْمُورِيَٰتِ قَدْحًۭا ﴿٢﴾

3
00:00:06,560 --> 00:00:09,640
فَٱلْمُغِيرَٰتِ صُبْحًۭا ﴿٣﴾

4
00:00:09,640 --> 00:00:12,720
فَأَثَرْنَ بِهِۦ نَقْعًۭا ﴿٤﴾

5
00:00:12,720 --> 00:00:16,040
فَوَسَطْنَ بِهِۦ جَمْعًا ﴿٥﴾

6
00:00:16,040 --> 00:00:23,720
إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ ﴿٦﴾

7
00:00:23,720 --> 00:00:30,490
وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ ﴿٧﴾

8
00:00:30,490 --> 00:00:37,600
وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ ﴿٨﴾

9
00:00:37,600 --> 00:00:44,710
۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ ﴿٩﴾

10
00:00:44,710 --> 00:00:49,590
وَحُصِّلَ مَا فِى ٱلصُّدُورِ ﴿١٠﴾

11
00:00:49,590 --> 00:01:00,140
إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ ﴿١١﴾

