1
00:00:00,000 --> 00:00:02,380
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ ﴿١﴾

2
00:00:02,380 --> 00:00:06,090
وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ ﴿٢﴾

3
00:00:06,090 --> 00:00:08,830
وَإِذَا ٱلْجِبَالُ سُيِّرَتْ ﴿٣﴾

4
00:00:08,830 --> 00:00:11,630
وَإِذَا ٱلْعِشَارُ عُطِّلَتْ ﴿٤﴾

5
00:00:11,630 --> 00:00:14,190
وَإِذَا ٱلْوُحُوشُ حُشِرَتْ ﴿٥﴾

6
00:00:14,190 --> 00:00:17,010
وَإِذَا ٱلْبِحَارُ سُجِّرَتْ ﴿٦﴾

7
00:00:17,010 --> 00:00:20,120
وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ ﴿٧﴾

8
00:00:20,120 --> 00:00:23,100
وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ ﴿٨﴾

9
00:00:23,100 --> 00:00:27,330
بِأَىِّ ذَنۢبٍۢ قُتِلَتْ ﴿٩﴾

10
00:00:27,330 --> 00:00:29,550
وَإِذَا ٱلصُّحُفُ نُشِرَتْ ﴿١٠﴾

11
00:00:29,550 --> 00:00:33,360
وَإِذَا ٱلسَّمَآءُ كُشِطَتْ ﴿١١﴾

12
00:00:33,360 --> 00:00:36,130
وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ ﴿١٢﴾

13
00:00:36,130 --> 00:00:39,890
وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ ﴿١٣﴾

14
00:00:39,890 --> 00:00:44,930
عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ ﴿١٤﴾

15
00:00:44,930 --> 00:00:50,780
فَلَآ أُقْسِمُ بِٱلْخُنَّسِ ﴿١٥﴾

16
00:00:50,780 --> 00:00:54,410
ٱلْجَوَارِ ٱلْكُنَّسِ ﴿١٦﴾

17
00:00:54,410 --> 00:00:57,360
وَٱلَّيْلِ إِذَا عَسْعَسَ ﴿١٧﴾

18
00:00:57,360 --> 00:01:00,570
وَٱلصُّبْحِ إِذَا تَنَفَّسَ ﴿١٨﴾

19
00:01:00,570 --> 00:01:06,630
إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ ﴿١٩﴾

20
00:01:06,630 --> 00:01:12,090
ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ ﴿٢٠﴾

21
00:01:12,090 --> 00:01:17,030
مُّطَاعٍۢ ثَمَّ أَمِينٍۢ ﴿٢١﴾

22
00:01:17,030 --> 00:01:22,180
وَمَا صَاحِبُكُم بِمَجْنُونٍۢ ﴿٢٢﴾

23
00:01:22,180 --> 00:01:27,460
وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ ﴿٢٣﴾

24
00:01:27,460 --> 00:01:32,610
وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ ﴿٢٤﴾

25
00:01:32,610 --> 00:01:36,420
وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ ﴿٢٥﴾

26
00:01:36,420 --> 00:01:39,660
فَأَيْنَ تَذْهَبُونَ ﴿٢٦﴾

27
00:01:39,660 --> 00:01:45,020
إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ ﴿٢٧﴾

28
00:01:45,020 --> 00:01:53,300
لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ ﴿٢٨﴾

29
00:01:53,300 --> 00:02:06,310
وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ ﴿٢٩﴾

