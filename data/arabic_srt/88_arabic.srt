1
00:00:00,000 --> 00:00:04,020
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ ﴿١﴾

2
00:00:04,020 --> 00:00:09,040
وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ ﴿٢﴾

3
00:00:09,040 --> 00:00:13,090
عَامِلَةٌۭ نَّاصِبَةٌۭ ﴿٣﴾

4
00:00:13,090 --> 00:00:16,510
تَصْلَىٰ نَارًا حَامِيَةًۭ ﴿٤﴾

5
00:00:16,510 --> 00:00:20,350
تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ ﴿٥﴾

6
00:00:20,350 --> 00:00:27,690
لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ ﴿٦﴾

7
00:00:27,690 --> 00:00:34,120
لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ ﴿٧﴾

8
00:00:34,120 --> 00:00:39,810
وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ ﴿٨﴾

9
00:00:39,810 --> 00:00:42,870
لِّسَعْيِهَا رَاضِيَةٌۭ ﴿٩﴾

10
00:00:42,870 --> 00:00:46,680
فِى جَنَّةٍ عَالِيَةٍۢ ﴿١٠﴾

11
00:00:46,680 --> 00:00:50,730
لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ ﴿١١﴾

12
00:00:50,730 --> 00:00:54,960
فِيهَا عَيْنٌۭ جَارِيَةٌۭ ﴿١٢﴾

13
00:00:54,960 --> 00:00:59,350
فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ ﴿١٣﴾

14
00:00:59,350 --> 00:01:03,430
وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ ﴿١٤﴾

15
00:01:03,430 --> 00:01:06,510
وَنَمَارِقُ مَصْفُوفَةٌۭ ﴿١٥﴾

16
00:01:06,510 --> 00:01:10,060
وَزَرَابِىُّ مَبْثُوثَةٌ ﴿١٦﴾

17
00:01:10,060 --> 00:01:16,090
أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ ﴿١٧﴾

18
00:01:16,090 --> 00:01:21,340
وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ ﴿١٨﴾

19
00:01:21,340 --> 00:01:24,970
وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ ﴿١٩﴾

20
00:01:24,970 --> 00:01:28,390
وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ ﴿٢٠﴾

21
00:01:28,390 --> 00:01:35,080
فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ ﴿٢١﴾

22
00:01:35,080 --> 00:01:39,100
لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ ﴿٢٢﴾

23
00:01:39,100 --> 00:01:43,490
إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ﴿٢٣﴾

24
00:01:43,490 --> 00:01:48,580
فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ ﴿٢٤﴾

25
00:01:48,580 --> 00:01:54,330
إِنَّ إِلَيْنَآ إِيَابَهُمْ ﴿٢٥﴾

26
00:01:54,330 --> 00:02:01,570
ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم ﴿٢٦﴾

