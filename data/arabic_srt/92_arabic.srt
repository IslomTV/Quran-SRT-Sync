1
00:00:00,000 --> 00:00:03,267
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ

2
00:00:03,267 --> 00:00:07,636
وَٱلنَّهَارِ إِذَا تَجَلَّىٰ

3
00:00:07,636 --> 00:00:12,593
وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ

4
00:00:12,593 --> 00:00:16,820
إِنَّ سَعْيَكُمْ لَشَتَّىٰ

5
00:00:16,820 --> 00:00:21,553
فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ

6
00:00:21,553 --> 00:00:24,455
وَصَدَّقَ بِٱلْحُسْنَىٰ

7
00:00:24,455 --> 00:00:28,180
فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ

8
00:00:28,180 --> 00:00:33,085
وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ

9
00:00:33,085 --> 00:00:35,898
وَكَذَّبَ بِٱلْحُسْنَىٰ

10
00:00:35,898 --> 00:00:39,448
فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ

11
00:00:39,448 --> 00:00:46,382
وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ

12
00:00:46,382 --> 00:00:50,128
إِنَّ عَلَيْنَا لَلْهُدَىٰ

13
00:00:50,128 --> 00:00:55,761
وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ

14
00:00:55,761 --> 00:01:01,491
فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ

15
00:01:01,491 --> 00:01:07,018
لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى

16
00:01:07,018 --> 00:01:11,014
ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ

17
00:01:11,014 --> 00:01:15,588
وَسَيُجَنَّبُهَا ٱلْأَتْقَى

18
00:01:15,588 --> 00:01:20,461
ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ

19
00:01:20,461 --> 00:01:28,309
وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ

20
00:01:28,309 --> 00:01:34,682
إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ

21
00:01:34,682 --> 00:01:38,681
وَلَسَوْفَ يَرْضَىٰ

