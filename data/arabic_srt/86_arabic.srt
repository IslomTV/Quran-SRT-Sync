1
00:00:00,000 --> 00:00:05,199
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ

2
00:00:05,199 --> 00:00:10,243
وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ

3
00:00:10,243 --> 00:00:13,877
ٱلنَّجْمُ ٱلثَّاقِبُ

4
00:00:13,877 --> 00:00:20,823
إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ

5
00:00:20,823 --> 00:00:27,735
فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ

6
00:00:27,735 --> 00:00:33,878
خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ

7
00:00:33,878 --> 00:00:41,255
يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ

8
00:00:41,255 --> 00:00:46,535
إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ

9
00:00:46,535 --> 00:00:50,999
يَوْمَ تُبْلَى ٱلسَّرَآئِرُ

10
00:00:50,999 --> 00:00:57,486
فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ

11
00:00:57,486 --> 00:01:02,233
وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ

12
00:01:02,233 --> 00:01:05,321
وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ

13
00:01:05,321 --> 00:01:10,048
إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ

14
00:01:10,048 --> 00:01:12,543
وَمَا هُوَ بِٱلْهَزْلِ

15
00:01:12,543 --> 00:01:17,256
إِنَّهُمْ يَكِيدُونَ كَيْدًۭا

16
00:01:17,256 --> 00:01:19,973
وَأَكِيدُ كَيْدًۭا

17
00:01:19,973 --> 00:01:27,155
فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا

