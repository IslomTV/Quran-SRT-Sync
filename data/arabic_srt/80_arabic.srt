1
00:00:00,000 --> 00:00:02,885
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ

2
00:00:02,885 --> 00:00:08,203
أَن جَآءَهُ ٱلْأَعْمَىٰ

3
00:00:08,203 --> 00:00:13,195
وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ

4
00:00:13,195 --> 00:00:18,459
أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ

5
00:00:18,459 --> 00:00:21,977
أَمَّا مَنِ ٱسْتَغْنَىٰ

6
00:00:21,977 --> 00:00:25,784
فَأَنتَ لَهُۥ تَصَدَّىٰ

7
00:00:25,784 --> 00:00:30,071
وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ

8
00:00:30,071 --> 00:00:36,510
وَأَمَّا مَن جَآءَكَ يَسْعَىٰ

9
00:00:36,510 --> 00:00:38,508
وَهُوَ يَخْشَىٰ

10
00:00:38,508 --> 00:00:41,981
فَأَنتَ عَنْهُ تَلَهَّىٰ

11
00:00:41,981 --> 00:00:47,805
كَلَّآ إِنَّهَا تَذْكِرَةٌۭ

12
00:00:47,805 --> 00:00:52,336
فَمَن شَآءَ ذَكَرَهُۥ

13
00:00:52,336 --> 00:00:55,764
فِى صُحُفٍۢ مُّكَرَّمَةٍۢ

14
00:00:55,764 --> 00:00:59,562
مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ

15
00:00:59,562 --> 00:01:01,723
بِأَيْدِى سَفَرَةٍۢ

16
00:01:01,723 --> 00:01:04,563
كِرَامٍۭ بَرَرَةٍۢ

17
00:01:04,563 --> 00:01:10,478
قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ

18
00:01:10,478 --> 00:01:13,725
مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ

19
00:01:13,725 --> 00:01:19,052
مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ

20
00:01:19,052 --> 00:01:23,140
ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ

21
00:01:23,140 --> 00:01:27,581
ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ

22
00:01:27,581 --> 00:01:34,039
ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ

23
00:01:34,039 --> 00:01:40,497
كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ

24
00:01:40,497 --> 00:01:46,710
فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ

25
00:01:46,710 --> 00:01:53,068
أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا

26
00:01:53,068 --> 00:01:57,780
ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا

27
00:01:57,780 --> 00:02:02,365
فَأَنۢبَتْنَا فِيهَا حَبًّۭا

28
00:02:02,365 --> 00:02:05,874
وَعِنَبًۭا وَقَضْبًۭا

29
00:02:05,874 --> 00:02:10,034
وَزَيْتُونًۭا وَنَخْلًۭا

30
00:02:10,034 --> 00:02:13,977
وَحَدَآئِقَ غُلْبًۭا

31
00:02:13,977 --> 00:02:17,694
وَفَٰكِهَةًۭ وَأَبًّۭا

32
00:02:17,694 --> 00:02:21,936
مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ

33
00:02:21,936 --> 00:02:29,425
فَإِذَا جَآءَتِ ٱلصَّآخَّةُ

34
00:02:29,425 --> 00:02:35,087
يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ

35
00:02:35,087 --> 00:02:40,577
وَأُمِّهِۦ وَأَبِيهِ

36
00:02:40,577 --> 00:02:44,900
وَصَٰحِبَتِهِۦ وَبَنِيهِ

37
00:02:44,900 --> 00:02:55,419
لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ

38
00:02:55,419 --> 00:03:00,936
وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ

39
00:03:00,936 --> 00:03:04,861
ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ

40
00:03:04,861 --> 00:03:10,767
وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ

41
00:03:10,767 --> 00:03:13,355
تَرْهَقُهَا قَتَرَةٌ

42
00:03:13,355 --> 00:03:20,336
أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ

