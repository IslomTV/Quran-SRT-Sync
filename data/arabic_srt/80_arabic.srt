1
00:00:00,000 --> 00:00:02,930
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ ﴿١﴾

2
00:00:02,930 --> 00:00:08,310
أَن جَآءَهُ ٱلْأَعْمَىٰ ﴿٢﴾

3
00:00:08,310 --> 00:00:13,350
وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ﴿٣﴾

4
00:00:13,350 --> 00:00:18,680
أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ ﴿٤﴾

5
00:00:18,680 --> 00:00:22,260
أَمَّا مَنِ ٱسْتَغْنَىٰ ﴿٥﴾

6
00:00:22,260 --> 00:00:26,130
فَأَنتَ لَهُۥ تَصَدَّىٰ ﴿٦﴾

7
00:00:26,130 --> 00:00:30,470
وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ ﴿٧﴾

8
00:00:30,470 --> 00:00:36,970
وَأَمَّا مَن جَآءَكَ يَسْعَىٰ ﴿٨﴾

9
00:00:36,970 --> 00:00:39,030
وَهُوَ يَخْشَىٰ ﴿٩﴾

10
00:00:39,030 --> 00:00:42,560
فَأَنتَ عَنْهُ تَلَهَّىٰ ﴿١٠﴾

11
00:00:42,560 --> 00:00:48,440
كَلَّآ إِنَّهَا تَذْكِرَةٌۭ ﴿١١﴾

12
00:00:48,440 --> 00:00:53,010
فَمَن شَآءَ ذَكَرَهُۥ ﴿١٢﴾

13
00:00:53,010 --> 00:00:56,480
فِى صُحُفٍۢ مُّكَرَّمَةٍۢ ﴿١٣﴾

14
00:00:56,480 --> 00:01:00,320
مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ ﴿١٤﴾

15
00:01:00,320 --> 00:01:02,540
بِأَيْدِى سَفَرَةٍۢ ﴿١٥﴾

16
00:01:02,540 --> 00:01:05,440
كِرَامٍۭ بَرَرَةٍۢ ﴿١٦﴾

17
00:01:05,440 --> 00:01:11,400
قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ ﴿١٧﴾

18
00:01:11,400 --> 00:01:14,690
مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ ﴿١٨﴾

19
00:01:14,690 --> 00:01:20,070
مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ﴿١٩﴾

20
00:01:20,070 --> 00:01:24,220
ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ﴿٢٠﴾

21
00:01:24,220 --> 00:01:28,710
ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ ﴿٢١﴾

22
00:01:28,710 --> 00:01:35,210
ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ﴿٢٢﴾

23
00:01:35,210 --> 00:01:41,710
كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ ﴿٢٣﴾

24
00:01:41,710 --> 00:01:47,980
فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ﴿٢٤﴾

25
00:01:47,980 --> 00:01:54,380
أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا ﴿٢٥﴾

26
00:01:54,380 --> 00:01:59,130
ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا ﴿٢٦﴾

27
00:01:59,130 --> 00:02:03,780
فَأَنۢبَتْنَا فِيهَا حَبًّۭا ﴿٢٧﴾

28
00:02:03,780 --> 00:02:07,330
وَعِنَبًۭا وَقَضْبًۭا ﴿٢٨﴾

29
00:02:07,330 --> 00:02:11,540
وَزَيْتُونًۭا وَنَخْلًۭا ﴿٢٩﴾

30
00:02:11,540 --> 00:02:15,540
وَحَدَآئِقَ غُلْبًۭا ﴿٣٠﴾

31
00:02:15,540 --> 00:02:19,300
وَفَٰكِهَةًۭ وَأَبًّۭا ﴿٣١﴾

32
00:02:19,300 --> 00:02:23,580
مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ ﴿٣٢﴾

33
00:02:23,580 --> 00:02:31,130
فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ﴿٣٣﴾

34
00:02:31,130 --> 00:02:36,850
يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ ﴿٣٤﴾

35
00:02:36,850 --> 00:02:42,390
وَأُمِّهِۦ وَأَبِيهِ ﴿٣٥﴾

36
00:02:42,390 --> 00:02:46,780
وَصَٰحِبَتِهِۦ وَبَنِيهِ ﴿٣٦﴾

37
00:02:46,780 --> 00:02:57,360
لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ ﴿٣٧﴾

38
00:02:57,360 --> 00:03:02,920
وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ ﴿٣٨﴾

39
00:03:02,920 --> 00:03:06,890
ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ ﴿٣٩﴾

40
00:03:06,890 --> 00:03:12,850
وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ ﴿٤٠﴾

41
00:03:12,850 --> 00:03:15,490
تَرْهَقُهَا قَتَرَةٌ ﴿٤١﴾

42
00:03:15,490 --> 00:03:22,520
أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ ﴿٤٢﴾

