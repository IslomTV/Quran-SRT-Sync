1
00:00:00,000 --> 00:00:04,050
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى ﴿١﴾

2
00:00:04,050 --> 00:00:07,550
ٱلَّذِى خَلَقَ فَسَوَّىٰ ﴿٢﴾

3
00:00:07,550 --> 00:00:11,050
وَٱلَّذِى قَدَّرَ فَهَدَىٰ ﴿٣﴾

4
00:00:11,050 --> 00:00:16,170
وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ ﴿٤﴾

5
00:00:16,170 --> 00:00:21,470
فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ ﴿٥﴾

6
00:00:21,470 --> 00:00:25,730
سَنُقْرِئُكَ فَلَا تَنسَىٰٓ ﴿٦﴾

7
00:00:25,730 --> 00:00:37,980
إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ ﴿٧﴾

8
00:00:37,980 --> 00:00:41,320
وَنُيَسِّرُكَ لِلْيُسْرَىٰ ﴿٨﴾

9
00:00:41,320 --> 00:00:46,180
فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ ﴿٩﴾

10
00:00:46,180 --> 00:00:50,830
سَيَذَّكَّرُ مَن يَخْشَىٰ ﴿١٠﴾

11
00:00:50,830 --> 00:00:55,090
وَيَتَجَنَّبُهَا ٱلْأَشْقَى ﴿١١﴾

12
00:00:55,090 --> 00:01:00,210
ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ ﴿١٢﴾

13
00:01:00,210 --> 00:01:06,710
ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ ﴿١٣﴾

14
00:01:06,710 --> 00:01:11,070
قَدْ أَفْلَحَ مَن تَزَكَّىٰ ﴿١٤﴾

15
00:01:11,070 --> 00:01:15,220
وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ ﴿١٥﴾

16
00:01:15,220 --> 00:01:19,710
بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا ﴿١٦﴾

17
00:01:19,710 --> 00:01:24,590
وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ ﴿١٧﴾

18
00:01:24,590 --> 00:01:29,840
إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ ﴿١٨﴾

19
00:01:29,840 --> 00:01:35,690
صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ ﴿١٩﴾

