1
00:00:00,000 --> 00:00:06,110
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ ﴿١﴾

2
00:00:06,110 --> 00:00:13,580
وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ ﴿٢﴾

3
00:00:13,580 --> 00:00:20,790
أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ ﴿٣﴾

4
00:00:20,790 --> 00:00:28,260
بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ ﴿٤﴾

5
00:00:28,260 --> 00:00:33,950
بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ ﴿٥﴾

6
00:00:33,950 --> 00:00:38,420
يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ ﴿٦﴾

7
00:00:38,420 --> 00:00:41,140
فَإِذَا بَرِقَ ٱلْبَصَرُ ﴿٧﴾

8
00:00:41,140 --> 00:00:43,200
وَخَسَفَ ٱلْقَمَرُ ﴿٨﴾

9
00:00:43,200 --> 00:00:46,330
وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ ﴿٩﴾

10
00:00:46,330 --> 00:00:52,630
يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ ﴿١٠﴾

11
00:00:52,630 --> 00:00:55,560
كَلَّا لَا وَزَرَ ﴿١١﴾

12
00:00:55,560 --> 00:01:00,240
إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ ﴿١٢﴾

13
00:01:00,240 --> 00:01:08,230
يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ ﴿١٣﴾

14
00:01:08,230 --> 00:01:13,610
بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ ﴿١٤﴾

15
00:01:13,610 --> 00:01:17,110
وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ ﴿١٥﴾

16
00:01:17,110 --> 00:01:22,200
لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ ﴿١٦﴾

17
00:01:22,200 --> 00:01:27,560
إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ ﴿١٧﴾

18
00:01:27,560 --> 00:01:32,370
فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ ﴿١٨﴾

19
00:01:32,370 --> 00:01:37,280
ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ ﴿١٩﴾

20
00:01:37,280 --> 00:01:41,280
كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ ﴿٢٠﴾

21
00:01:41,280 --> 00:01:44,150
وَتَذَرُونَ ٱلْءَاخِرَةَ ﴿٢١﴾

22
00:01:44,150 --> 00:01:48,960
وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ ﴿٢٢﴾

23
00:01:48,960 --> 00:01:52,090
إِلَىٰ رَبِّهَا نَاظِرَةٌۭ ﴿٢٣﴾

24
00:01:52,090 --> 00:01:57,450
وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ ﴿٢٤﴾

25
00:01:57,450 --> 00:02:03,170
تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ ﴿٢٥﴾

26
00:02:03,170 --> 00:02:08,710
كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ ﴿٢٦﴾

27
00:02:08,710 --> 00:02:14,140
وَقِيلَ مَنْ ۜ رَاقٍۢ ﴿٢٧﴾

28
00:02:14,140 --> 00:02:19,940
وَظَنَّ أَنَّهُ ٱلْفِرَاقُ ﴿٢٨﴾

29
00:02:19,940 --> 00:02:25,060
وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ ﴿٢٩﴾

30
00:02:25,060 --> 00:02:31,200
إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ ﴿٣٠﴾

31
00:02:31,200 --> 00:02:34,570
فَلَا صَدَّقَ وَلَا صَلَّىٰ ﴿٣١﴾

32
00:02:34,570 --> 00:02:38,800
وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ ﴿٣٢﴾

33
00:02:38,800 --> 00:02:45,100
ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ ﴿٣٣﴾

34
00:02:45,100 --> 00:02:47,820
أَوْلَىٰ لَكَ فَأَوْلَىٰ ﴿٣٤﴾

35
00:02:47,820 --> 00:02:51,840
ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ ﴿٣٥﴾

36
00:02:51,840 --> 00:02:58,210
أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى ﴿٣٦﴾

37
00:02:58,210 --> 00:03:05,160
أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ ﴿٣٧﴾

38
00:03:05,160 --> 00:03:11,380
ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ ﴿٣٨﴾

39
00:03:11,380 --> 00:03:17,540
فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ ﴿٣٩﴾

40
00:03:17,540 --> 00:03:27,960
أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ ﴿٤٠﴾

